# ── LLM Provider ──────────────────────────────────────
# Required: your Mistral AI API key
MISTRAL_API_KEY=your-mistral-api-key

# Optional overrides (defaults shown):
# PROMPTHUB_BASE_URL=https://api.mistral.ai/v1
# PROMPTHUB_MODEL=mistral-large-latest

# ── Database ──────────────────────────────────────────
# Not set = local SQLite (backend/prompt_hub.db)
# Set to a PostgreSQL URL for production (e.g. Supabase)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed origins (frontend URLs)
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:6052

# ── Supabase Auth (backend) ───────────────────────────
# JWT secret used to verify access tokens issued by Supabase Auth.
# Found in: Supabase Dashboard → Settings → API → JWT Settings → "JWT Secret"
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Optional: only used for logging / debug context.
SUPABASE_URL=https://fjhdsmrsangexacypkxb.supabase.co

# ── Supabase Auth (frontend, prefixed with VITE_) ─────
# These belong in frontend/.env.local — listed here for convenience.
# VITE_SUPABASE_URL=https://fjhdsmrsangexacypkxb.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
